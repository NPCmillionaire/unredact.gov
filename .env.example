# ── storage ──
UNREDACT_DATA_DIR=~/.local/share/unredact

# ── FOIA requester identity (appears on every letter) ──
REQUESTER_NAME="Cameron R. Preston"
REQUESTER_EMAIL=foia@yourdomain.com
REQUESTER_PHONE=
REQUESTER_ADDRESS="Youngstown, OH"

# ── outbound email (use your own domain with SPF/DKIM/DMARC) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Cameron Preston <foia@yourdomain.com>"
SMTP_STARTTLS=true

# ── inbound email: agency replies ──
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ── data sources ──
FOIA_GOV_API_KEY=            # https://www.foia.gov/developer/
GEOCODIO_API_KEY=            # optional; falls back to the free US Census geocoder
# GEOCODIO_URL=https://api.geocod.io/v1.9/geocode

# ── House Communicating with Congress (after vendor approval) ──
CWC_API_KEY=
CWC_HOST=test-cwc.house.gov  # switch to cwc.house.gov when approved
CWC_DELIVERY_AGENT="Cloudsculpting Labs LLC"
CWC_DELIVERY_AGENT_ACK_EMAIL=
CWC_DELIVERY_AGENT_CONTACT_NAME=
CWC_DELIVERY_AGENT_CONTACT_EMAIL=
CWC_DELIVERY_AGENT_CONTACT_PHONE=
CWC_ORGANIZATION=
CWC_CAMPAIGN_ID=unredact

# ── web-form definitions (contact-congress YAML format) ──
# WEBFORM_DEFS_DIR=~/.local/share/unredact/contact-congress/members

# ── paid letters ──
LOB_API_KEY=                 # test_… keys print nothing and cost nothing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LETTER_PRICE_CENTS=300

# ── web ──
BASE_URL=http://127.0.0.1:8000
UNREDACT_ADMIN_PASSWORD=

# ── public-site safety ──
REQUIRE_EMAIL_VERIFICATION=true   # constituents confirm by email before anything is sent (needs SMTP)
RATE_LIMIT_PER_HOUR=20            # per IP, per endpoint
UNREDACT_TRUST_PROXY=false        # true behind Caddy/nginx so X-Forwarded-For is used
